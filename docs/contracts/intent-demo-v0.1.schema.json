{
  "$defs": {
    "BehaviorEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "step_index": {
          "minimum": 1,
          "title": "Step Index",
          "type": "integer"
        },
        "actor": {
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "user",
            "agent",
            "retrieval",
            "tool",
            "memory",
            "system"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "subgoal": {
          "title": "Subgoal",
          "type": "string"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "args_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Args Digest",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "risk_flags": {
          "items": {
            "type": "string"
          },
          "title": "Risk Flags",
          "type": "array"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "task_id",
        "step_index",
        "actor",
        "source_type",
        "source_ref",
        "subgoal",
        "tool",
        "action",
        "args_digest",
        "target",
        "risk_flags",
        "timestamp"
      ],
      "title": "BehaviorEvent",
      "type": "object"
    },
    "CorrectionPlan": {
