APP_ENV=development
RUNTIME_MODE=offline
DATABASE_URL=sqlite+aiosqlite:///./.runtime/ra_agent.db
SECURITY_CONFIG_DIR=configs

# Copy this file to .env. Keep real credentials only in .env.
# LLM_BASE_URL is the provider's OpenAI-compatible API base URL.
LLM_BASE_URL=
LLM_API_KEY=
PLANNER_MODEL=
CHECKER_MODEL=

WORKSPACE_ROOT=.runtime/workspace
PENDING_ROOT=.runtime/pending
CHECKPOINT_ROOT=.runtime/checkpoints
QUARANTINE_ROOT=.runtime/quarantine
MAX_PATH_LENGTH=4096
MAX_READ_BYTES=1048576
# Optional independent checkpoint backup cap; omitted = MAX_READ_BYTES.
# MAX_BACKUP_BYTES=1048576
MAX_WRITE_BYTES=1048576
MAX_LIST_ENTRIES=1000
MAX_AGENT_TURNS=8
# Long conversations retain this many recent messages verbatim and compact older text.
CONVERSATION_RECENT_MESSAGES=12
CONVERSATION_SUMMARY_CHARACTERS=4000

# Aegis Core cryptographic evidence stack. "fake" preserves PR1 development mode.
# Set "sm2" only with all trusted key settings below; startup then fails closed.
CORE_CRYPTO_MODE=fake
# CORE_SM2_KEY_ID=core-signing-key
# CORE_SM2_PUBLIC_KEYS_PATH=.runtime/core/public-keys.json
# CORE_SM2_PRIVATE_KEY_PATH=.runtime/core/private.pem
CORE_EVENT_LOG_PATH=.runtime/core/events.jsonl
CORE_EVIDENCE_ROOT=.runtime/core/evidence
CORE_AUDIT_CHECKPOINT_ROOT=.runtime/core/trusted-checkpoints

# Aegis-Intent Person 1 integration baseline.
# Bound tasks are checked before tool execution; unbound Core tasks keep legacy behaviour.
INTENT_BASELINE_ENABLED=true
INTENT_DETECTION_TIMEOUT_SECONDS=1.0
