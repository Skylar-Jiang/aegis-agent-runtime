{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "eslint.config.js",
    "coreMockPlugin.ts",
    "src/vite-env.d.ts",
    "src/api/url.ts",
    "src/features/core/generated.ts",
    "src/features/core/gateway.ts",
    "src/features/core/mock/FakeToolGateway.ts",
    "src/features/core/mock/events.json"
  ]
}
